# Credentials for backup.js (daily S3 JSON upload).
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
#
# The IAM user backing these keys only needs s3:PutObject on the bucket prefix
# below — `tofu/` provisions exactly that. See README "Backups (S3)".
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=eu-central-1
AWS_S3_BUCKET=your-fitness-tracker-backups
AWS_S3_PREFIX=backups
