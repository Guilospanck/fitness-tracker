[Unit]
Description=Fitness Tracker
After=network.target

[Service]
Type=simple
# __USER__ / __HOME__ are substituted by `just systemd-install` from the
# account that runs it ($USER / $HOME). Don't hardcode a name here.
User=__USER__
WorkingDirectory=__HOME__/fitness-tracker
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Own port so it doesn't collide with money-tracker (3000) on the same box.
Environment=PORT=3001

[Install]
WantedBy=multi-user.target
